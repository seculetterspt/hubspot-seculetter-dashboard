{
  "name": "hubspot-seculetter-backend",
  "version": "1.0.0",
  "description": "Seculetter HubSpot Dashboard Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:frontend": "cd ../frontend && npm install && npm run build && cd ../backend && rm -rf public && cp -r ../frontend/dist public",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hubspot/api-client": "^13.4.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.11",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "axios": "^1.7.9",
    "connect-pg-simple": "^8.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.0",
    "node-cron": "^3.0.3",
    "openai": "^6.17.0",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
