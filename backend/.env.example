# HubSpot Configuration
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token
HUBSPOT_ACCOUNT_ID=243367573

# HubSpot OAuth Configuration (for identity only)
HUBSPOT_CLIENT_ID=your_hubspot_oauth_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_oauth_client_secret
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:3001/auth/hubspot/callback

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/seculetter_hubspot

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Session Configuration
SESSION_SECRET=your_session_secret_change_in_production

# User Access Control (optional - if not set, all users allowed in dev)
ALLOWED_EMAIL_DOMAINS=seculetter.com
ALLOWED_EMAILS=user1@example.com,user2@example.com

# Application Base URL
APP_BASE_URL=http://localhost:3001
