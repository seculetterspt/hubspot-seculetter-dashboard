# ============================================
# HubSpot Configuration
# ============================================
# Required for HubSpot API operations
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token
HUBSPOT_ACCOUNT_ID=243367573

# ============================================
# HubSpot OAuth Configuration (REQUIRED for authentication)
# ============================================
# These are required to enable HubSpot OAuth login
# Get from: HubSpot Settings → Integrations → Private Apps → Create
# 1. Create a Private App in HubSpot
# 2. Add OAuth scopes: crm.objects.contacts.read, oauth
# 3. Copy the Client ID and Client Secret
HUBSPOT_CLIENT_ID=your_hubspot_oauth_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_oauth_client_secret
# For local dev: http://localhost:3001/auth/hubspot/callback
# For production: https://your-domain.com/auth/hubspot/callback
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:3001/auth/hubspot/callback

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/seculetter_hubspot

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# Frontend URL for CORS headers
FRONTEND_URL=http://localhost:5173

# ============================================
# Session Configuration (REQUIRED)
# ============================================
# Secret for signing session cookies
# Generate: openssl rand -hex 32
SESSION_SECRET=your_session_secret_change_in_production

# ============================================
# User Access Control (OPTIONAL)
# ============================================
# If not set, all users are allowed in development mode
# Email domains allowed to access the application (comma-separated)
ALLOWED_EMAIL_DOMAINS=seculetter.com

# Specific email addresses allowed (comma-separated)
# Takes precedence over domain whitelist
ALLOWED_EMAILS=user1@example.com,user2@example.com

# ============================================
# Application Configuration
# ============================================
# Base URL for the application
APP_BASE_URL=http://localhost:3001
